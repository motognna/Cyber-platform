FROM docker.io/library/ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# SSH server + rsyslog (scrie /var/log/auth.log) + nginx (access.log in format combined)
RUN apt-get update && apt-get install -y --no-install-recommends \
        openssh-server rsyslog nginx \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/run/sshd

# Containerele nu au kernel log: dezactivam imklog ca rsyslog sa porneasca fara erori
RUN sed -i '/imklog/s/^/#/' /etc/rsyslog.conf

# Utilizator tinta cu parola SLABA - INTENTIONAT (doar pentru laborator local!)
RUN useradd -m -s /bin/bash victim \
    && echo "victim:password123" | chpasswd

# Parola permisa pe SSH, root login interzis (ca pe majoritatea serverelor reale)
RUN sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config \
    && sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config

RUN echo "<h1>Cyber Lab - Victim Server</h1>" > /var/www/html/index.html

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 22 80
CMD ["/entrypoint.sh"]
